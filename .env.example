# PersonalOS environment example
# This file is intentionally sanitized for public sharing.
# Keep real credentials in an untracked `.env` file.

# Feedback transport: SMTP
FEEDBACK_SMTP_HOST=smtp.example.com
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_SECURE=false
FEEDBACK_SMTP_USER=replace-with-smtp-username
FEEDBACK_SMTP_PASS=replace-with-app-password
FEEDBACK_TO_EMAIL=support@example.com
FEEDBACK_FROM_EMAIL=no-reply@example.com
FEEDBACK_FROM_NAME=PersonalOS Feedback

# Optional feedback transport: backend endpoint
# FEEDBACK_BACKEND_URL=https://api.example.com/feedback
# FEEDBACK_BACKEND_API_KEY=replace-with-backend-api-key
