{
  "name": "personal-operating-system",
  "version": "1.0.0",
  "description": "A personal operating system built with Electron, React, and TypeScript.",
  "pnpm": {
    "packageExtensions": {
      "@malept/flatpak-bundler@*": {
        "dependencies": {
          "tmp-promise": "^3.0.3"
        }
      }
    }
  },
  "scripts": {
    "start:tauri": "pnpm exec tauri dev",
    "build:tauri": "pnpm exec tauri build",
    "tauri": "tauri",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$targets=@('out','.webpack','dist','renderer/dist','renderer/node_modules/.vite','node_modules/.cache','renderer/node_modules/.cache'); foreach($t in $targets){ if(Test-Path $t){ Remove-Item -Recurse -Force $t } }\"",
    "clean:deps": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$targets=@('renderer/node_modules'); foreach($t in $targets){ if(Test-Path $t){ Remove-Item -Recurse -Force $t } }\"",
    "lint": "eslint --ext .ts,.tsx .",
    "type-check": "tsc -p renderer/tsconfig.json --noEmit",
    "build:undo": "tsc -p undo/tsconfig.json",
    "build:sync": "tsc -p sync/tsconfig.json",
    "emailjs:test": "node scripts/emailjs-feedback-test.js",
    "feedback:test": "node scripts/feedback-smtp-test.js"
  },
  "keywords": [],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "node-gyp": "^12.1.0",
    "postcss": "^8.5.6",
    "prebuild-install": "^7.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "tmp-promise": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.90.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.1",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.334.0",
    "react-day-picker": "^8.10.0",
    "react-hook-form": "^7.71.1",
    "react-hotkeys-hook": "^5.2.3",
    "react-router-dom": "^6.22.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1",
    "zustand": "^4.5.1"
  }
}