{
  "appId": "com.progressos.app",
  "productName": "Progress OS",
  "artifactName": "${productName}-Setup-${version}.${ext}",
  "asar": true,
  "directories": {
    "output": "out/installer",
    "buildResources": "build"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/POS-ICON.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Progress OS",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerIcon": "build/POS-ICON.ico",
    "uninstallerIcon": "build/POS-ICON.ico",
    "installerHeaderIcon": "build/POS-ICON.ico",
    "uninstallDisplayName": "Progress OS",
    "artifactName": "${productName}-Installer-${version}.${ext}"
  },
  "publish": null
}
