{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "personal_os",
    "version":  "0.1.0",
    "identifier":  "com.personalos.app",
    "build":  {
                  "frontendDist":  "../renderer/dist",
                  "devUrl":  "http://localhost:3000",
                  "beforeDevCommand":  "pnpm --dir renderer start",
                  "beforeBuildCommand":  "pnpm --dir renderer build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Personal OS",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: ws://localhost:*;"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               },
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               }
}
